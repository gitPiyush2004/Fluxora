# =============================================================================
# Fluxora environment configuration
# Copy to server/.env (local dev) or .env at the repo root (docker compose).
# Never commit real secrets.
# =============================================================================

# ---- Required ---------------------------------------------------------------
NODE_ENV=development
PORT=4100
# Public URL of the web client (used for CORS + links)
CLIENT_URL=http://localhost:5180
SERVER_URL=http://localhost:4100
MONGODB_URI=mongodb://127.0.0.1:27017/fluxora
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# ---- Sessions / cookies -----------------------------------------------------
SESSION_TTL_HOURS=12
# lax (same-site deployment, recommended) | strict | none (cross-site API; requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
# true in production (HTTPS)
COOKIE_SECURE=false
# Number of reverse-proxy hops to trust (e.g. 1 behind a load balancer)
TRUST_PROXY=0
# Comma-separated list of allowed browser origins (defaults to CLIENT_URL)
CORS_ORIGIN=

# ---- Google sign-in (optional, recommended) ---------------------------------
# OAuth 2.0 Web client ID from Google Cloud Console. Authorized JavaScript origin: CLIENT_URL.
# The ID-token flow used here does not need a client secret.
GOOGLE_CLIENT_ID=

# ---- Development only -------------------------------------------------------
# Enables one-click sign-in as seeded demo users. Refused when NODE_ENV=production.
AUTH_DEV_LOGIN_ENABLED=true
LOG_LEVEL=info

# ---- Redis (optional) -------------------------------------------------------
# Enables shared quote cache, distributed rate limiting and BullMQ jobs.
# Without it Fluxora uses in-memory fallbacks (single instance only).
REDIS_URL=

# ---- Carrier comparison / jobs ----------------------------------------------
QUOTE_CACHE_TTL_SECONDS=300
CARRIER_TIMEOUT_MS=8000
# Labelled demonstration quotes/bookings/tracking for carriers without credentials
CARRIER_SIMULATION_ENABLED=true
JOBS_ENABLED=true
EXCEPTION_SCAN_INTERVAL_SECONDS=300
TRACKING_POLL_INTERVAL_SECONDS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300

# ---- Carrier credentials (all optional) -------------------------------------
# DHL Shipment Tracking – Unified API (https://developer.dhl.com/api-reference/shipment-tracking)
DHL_TRACKING_API_KEY=
DHL_TRACKING_BASE_URL=https://api-eu.dhl.com
# DHL Express MyDHL API rating (requires DHL Express account). Use .../mydhlapi for production.
DHL_EXPRESS_USERNAME=
DHL_EXPRESS_PASSWORD=
DHL_EXPRESS_ACCOUNT_NUMBER=
DHL_EXPRESS_BASE_URL=https://express.api.dhl.com/mydhlapi/test
# FedEx REST APIs (https://developer.fedex.com/). Production: https://apis.fedex.com
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=
FEDEX_BASE_URL=https://apis-sandbox.fedex.com
# UPS REST APIs (https://developer.ups.com/). Use https://onlinetools.ups.com for production.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
UPS_BASE_URL=https://wwwcie.ups.com
# Partner-onboarding carriers — no adapter implemented yet (see README); values are ignored.
# DSV Generic Tracking API (https://developer.dsv.com/). Subscribe to "DSV Access Token" and
# "Tracking" there; each subscription has its own key. Use https://api.dsv.com/my for production.
# DSV's tracking docs publish a shared demo login: api.demo@demo.dsv.com / Demo12345.
DSV_USERNAME=
DSV_PASSWORD=
DSV_TOKEN_SUBSCRIPTION_KEY=
DSV_TRACKING_SUBSCRIPTION_KEY=
DSV_BASE_URL=https://api.dsv.com/my-demo
KN_CLIENT_ID=
KN_CLIENT_SECRET=
CEVA_API_KEY=
